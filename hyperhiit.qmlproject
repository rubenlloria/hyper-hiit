import QmlProject

Project {
    // Fitxer principal per a l'execució en el runtime de disseny
    mainFile: "ui/main.qml"

    // La teva pantalla principal (antiga Screen01) [1]
    mainUiFile: "ui/views/DashboardForm.ui.qml"

    /* Inclusió de fitxers QML de la nova estructura [1] */
    QmlFiles {
        directory: "ui"
    }

    QmlFiles {
        directory: "ui/components"
    }

    QmlFiles {
        directory: "ui/views"
    }

    /* Gestió d'imatges i icones */
    ImageFiles {
        directory: "res"
    }

    ImageFiles {
        directory: "ui/assets/icons"
    }
    
    ImageFiles {
        directory: "ui/assets/images"
    }
    
    /* Configuració de les fonts segons la teva estructura [1] */
    FontFiles {
        directory: "ui/assets/fonts"
        filter: "*.ttf;*.otf"
    }

    Files {
        filter: "*.conf"
        files: ["qtquickcontrols2.conf"]
    }

    Files {
        filter: "qmldir"
        directory: "ui"
    }
/*
    Files {
        filter: "*.wav;*.mp3"
    }

    Files {
        filter: "*.mp4"
    }

    Files {
        filter: "*.glsl;*.glslv;*.glslf;*.vsh;*.fsh;*.vert;*.frag"
    }

    Files {
        filter: "*.qsb"
    }

    Files {
        filter: "*.json"
    }

    Files {
        filter: "*.mesh"
        directory: "Generated"
    }

    Files {
        filter: "*.qad"
        directory: "Generated"
    }
*/
    Environment {
        QT_QUICK_CONTROLS_CONF: "qtquickcontrols2.conf"
        QML_COMPAT_RESOLVE_URLS_ON_ASSIGNMENT: "1"
        QT_LOGGING_RULES: "qt.qml.connections=false"
        QT_ENABLE_HIGHDPI_SCALING: "0"
        /* Useful for debugging
       QSG_VISUALIZE=batches
       QSG_VISUALIZE=clip
       QSG_VISUALIZE=changes
       QSG_VISUALIZE=overdraw
       */
    }

    qt6Project: true

    /* List of plugin directories passed to QML runtime */
    importPaths: [ "ui" ]

    qdsVersion: "4.8"

    quickVersion: "6.10"

    /* If any modules the project imports require widgets (e.g. QtCharts), widgetApp must be true */
    widgetApp: true

    /* args: Specifies command line arguments for qsb tool to generate shaders.
       files: Specifies target files for qsb tool. If path is included, it must be relative to this file.
              Wildcard '*' can be used in the file name part of the path.
              e.g. files: [ "QtdTestContent/shaders/*.vert", "*.frag" ]  */
    ShaderTool {
        args: "-s --glsl \"100 es,120,150\" --hlsl 50 --msl 12"
        files: [ "ui/assets/shaders/*" ]
    }

    multilanguageSupport: true
    supportedLanguages: ["en", "ca", "es"]
    primaryLanguage: "en"

}
